# Environment Configuration
# Copy this file to .env and fill in the values

# Server
PORT=3001
NODE_ENV=development

# JWT
JWT_SECRET=roadrescue-super-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Database
DB_PATH=./db/roadrescue.db

# City Center (used for seeding mechanics around this location)
# Default: Chennai, India
CITY_CENTER_LAT=13.0827
CITY_CENTER_LNG=80.2707
CITY_NAME=Chennai

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Share Link
SHARE_TOKEN_EXPIRY_HOURS=24
PUBLIC_URL=http://localhost:5173
